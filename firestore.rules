rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email.toLowerCase() == "eemmpatech@gmail.com" ||
         request.auth.token.email.toLowerCase() == "eemmpatec@gmail.com" ||
         (exists(/databases/$(database)/documents/sib_profiles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/sib_profiles/$(request.auth.uid)).data.role == 'admin'));
    }

    function incoming() {
      return request.resource.data;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /sib_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin()) && 
                               (incoming().get('role', 'user') == 'user' || isAdmin());
      allow delete: if isAdmin();
    }

    match /sib_results/{resultId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /sib_payments/{paymentId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAuthenticated() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /sib_questions/{questionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /sib_alerts/{alertId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    match /sib_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /sib_fun_rooms/{roomId} {
      allow read, write: if isAuthenticated();
    }

    match /sib_game_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    match /library_books/{bookId} {
      allow read, write: if true;
    }

    match /sib_library_files/{fileId} {
      allow read, write: if true;
    }

    match /sib_library_deletions/{docId} {
      allow read, write: if true;
    }

    // Institutional CBT Requests, Rooms, and Submissions
    match /sib_inst_requests/{requestId} {
      allow create, read, update, delete: if true;
    }

    match /sib_inst_rooms/{roomId} {
      allow create, read, update, delete: if true;
    }

    match /sib_inst_submissions/{submissionId} {
      allow create, read, update, delete: if true;
    }
  }
}
